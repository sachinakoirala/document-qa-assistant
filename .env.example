# Copy this file to `.env` and fill in your real key, or just `export` these
# variables in your shell before running `python ask.py`.

# Required: your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the model. See the current list at
# https://docs.claude.com/en/docs/about-claude/models
# ANTHROPIC_MODEL=claude-sonnet-5
